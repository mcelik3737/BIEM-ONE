generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  SUPER_ADMIN
  COMPANY_ADMIN
  PROJECT_MANAGER
  FIELD_ENGINEER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum WorkCategory {
  RADIO_COMMUNICATION
  RF_COVERAGE_DAS
  RAIL_SYSTEMS
  EMERGENCY_COMMUNICATION
  EV_CHARGING
  SERVICE_MAINTENANCE
  OTHER
}

enum OperationStage {
  HAZIRLIK
  SATINALMA
  IS_PROGRAMI
  ISG
  KURULUM_SERVIS
  TEST
  SAT_KABUL
  TESLIM
  FATURALAMA
  TAHSILAT
  KAPANIS_BAKIM
}

enum BomItemType {
  URUN
  MALZEME
  HIZMET
  ISCILIK
  TASERON
  EKIPMAN
}

enum ProcurementStatus {
  PLANLANDI
  TEKLIF_BEKLENIYOR
  ONAY_BEKLIYOR
  SIPARIS_VERILDI
  KISMI_TESLIM
  TESLIM_ALINDI
  IPTAL
}

enum PurchaseOrderStatus {
  TASLAK
  ONAY_BEKLIYOR
  ONAYLANDI
  SIPARIS_VERILDI
  KISMI_TESLIM
  TESLIM_ALINDI
  IPTAL
}

enum NotificationType {
  INFO
  ACTION_REQUIRED
  WARNING
}

model Company {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 User[]
  customers             Customer[]
  projects              Project[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderCounters PurchaseOrderCounter[]
  employees             Employee[]
}

model User {
  id                      String                 @id @default(cuid())
  companyId               String
  email                   String                 @unique
  passwordHash            String
  fullName                String
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  company                 Company                @relation(fields: [companyId], references: [id])
  roles                   UserRole[]
  refreshTokens           RefreshToken[]
  tasks                   Task[]                 @relation("TaskAssignee")
  notifications           Notification[]
  uploadedFiles           FileAsset[]
  auditLogs               AuditLog[]
  timelineEvents          TimelineEvent[]
  ownedProjects           Project[]              @relation("ProjectOwner")
  completedChecklistItems ProjectChecklistItem[] @relation("ChecklistCompletedBy")
  managedOperations       ProjectOperation[]     @relation("OperationManager")
  createdPurchaseOrders   PurchaseOrder[]        @relation("PurchaseOrderCreatedBy")
  approvedPurchaseOrders  PurchaseOrder[]        @relation("PurchaseOrderApprovedBy")
  employee                Employee?
}

model Role {
  id          String           @id @default(cuid())
  name        String
  code        RoleCode         @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id          String      @id @default(cuid())
  companyId   String
  name        String
  shortName   String?
  contactName String?
  code        String?
  taxOffice   String?
  taxNumber   String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  projects    Project[]
  files       FileAsset[]
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  fullName   String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model ProjectStage {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  sortOrder Int
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id                   String                 @id @default(cuid())
  companyId            String
  customerId           String?
  ownerId              String?
  stageId              String
  name                 String
  workNumber           String?                @unique
  code                 String?
  description          String?
  location             String?
  category             WorkCategory?
  customerContactName  String?
  customerContactPhone String?
  customerContactEmail String?
  nextAction           String?
  nextActionDate       DateTime?
  startDate            DateTime?
  endDate              DateTime?
  priority             WorkPriority           @default(NORMAL)
  estimatedValue       Decimal?               @db.Decimal(18, 2)
  quotedValue          Decimal?               @db.Decimal(18, 2)
  plannedCost          Decimal?               @db.Decimal(18, 2)
  currency             String?
  probabilityPercent   Int?
  paymentTerms         String?
  deliveryTerms        String?
  offerNumber          String?
  offerRevision        String?
  offerDate            DateTime?
  offerValidUntil      DateTime?
  technicalSummary     String?
  frequencyBand        String?
  estimatedQuantity    Int?
  contractPoReference  String?
  source               String?
  dueDate              DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer             Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner                User?                  @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stage                ProjectStage           @relation(fields: [stageId], references: [id], onDelete: Restrict)
  tasks                Task[]
  files                FileAsset[]
  timelineEvents       TimelineEvent[]
  checklistItems       ProjectChecklistItem[]
  operation            ProjectOperation?
  employeeTimeEntries  EmployeeTimeEntry[]
}

model ProjectOperation {
  id                 String          @id @default(cuid())
  projectId          String          @unique
  operationStage     OperationStage  @default(HAZIRLIK)
  operationManagerId String?
  plannedStartAt     DateTime?
  plannedEndAt       DateTime?
  actualStartAt      DateTime?
  actualEndAt        DateTime?
  completionPercent  Int             @default(0)
  nextAction         String?
  nextActionDueAt    DateTime?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  operationManager   User?           @relation("OperationManager", fields: [operationManagerId], references: [id], onDelete: SetNull)
  bomItems           BomItem[]
  purchaseOrders     PurchaseOrder[]

  @@index([operationStage])
  @@index([operationManagerId])
}

model BomItem {
  id                 String              @id @default(cuid())
  projectOperationId String
  itemType           BomItemType
  stockCode          String?
  description        String
  brand              String?
  model              String?
  quantity           Decimal             @db.Decimal(18, 3)
  unit               String
  currency           String
  estimatedUnitCost  Decimal             @default(0) @db.Decimal(18, 2)
  estimatedTotalCost Decimal             @default(0) @db.Decimal(18, 2)
  requiredAt         DateTime?
  procurementStatus  ProcurementStatus   @default(PLANLANDI)
  technicalNote      String?
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  projectOperation   ProjectOperation    @relation(fields: [projectOperationId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]

  @@index([projectOperationId, sortOrder])
  @@index([projectOperationId, procurementStatus])
}

model Supplier {
  id             String          @id @default(cuid())
  companyId      String
  name           String
  contactName    String?
  phone          String?
  email          String?
  taxOffice      String?
  taxNumber      String?
  address        String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([companyId, isActive])
  @@index([companyId, name])
}

model PurchaseOrderCounter {
  id        String   @id @default(cuid())
  companyId String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year])
}

model PurchaseOrder {
  id                 String              @id @default(cuid())
  companyId          String
  orderNumber        String
  projectOperationId String
  supplierId         String
  status             PurchaseOrderStatus @default(TASLAK)
  orderDate          DateTime            @default(now())
  expectedDeliveryAt DateTime?
  currency           String
  subtotal           Decimal             @default(0) @db.Decimal(18, 2)
  taxTotal           Decimal             @default(0) @db.Decimal(18, 2)
  grandTotal         Decimal             @default(0) @db.Decimal(18, 2)
  notes              String?
  createdById        String
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectOperation   ProjectOperation    @relation(fields: [projectOperationId], references: [id], onDelete: Restrict)
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy          User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy         User?               @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items              PurchaseOrderItem[]

  @@unique([companyId, orderNumber])
  @@index([projectOperationId, status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  bomItemId        String?
  description      String
  quantity         Decimal       @db.Decimal(18, 3)
  receivedQuantity Decimal       @default(0) @db.Decimal(18, 3)
  unit             String
  unitPrice        Decimal       @db.Decimal(18, 2)
  taxRate          Decimal       @default(0) @db.Decimal(5, 2)
  lineTotal        Decimal       @db.Decimal(18, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  bomItem          BomItem?      @relation(fields: [bomItemId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([bomItemId])
}

model ProjectChecklistItem {
  id            String       @id @default(cuid())
  projectId     String
  key           String
  title         String
  stageCode     String
  category      WorkCategory
  isCompleted   Boolean      @default(false)
  completedAt   DateTime?
  completedById String?
  sortOrder     Int
  isRequired    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  completedBy   User?        @relation("ChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([projectId, key])
  @@index([projectId, stageCode])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String?
  assigneeId  String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}

model FileAsset {
  id           String    @id @default(cuid())
  projectId    String?
  customerId   String?
  uploadedById String?
  fileName     String
  mimeType     String
  storagePath  String
  sizeBytes    Int
  createdAt    DateTime  @default(now())
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String
  kind      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model TimelineEvent {
  id         String   @id @default(cuid())
  projectId  String?
  actorId    String?
  eventType  String
  summary    String
  details    String?
  occurredAt DateTime @default(now())
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model Employee {
  id             String   @id @default(cuid())
  companyId      String
  userId         String?  @unique
  fullName       String
  jobTitle       String
  jobDescription String?
  department     String?
  email          String?
  phone          String?
  startDate      DateTime @db.Date
  endDate        DateTime? @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  compensations  EmployeeCompensation[]
  documents      EmployeeDocument[]
  timeEntries    EmployeeTimeEntry[]

  @@index([companyId, isActive])
}

model EmployeeCompensation {
  id                  String   @id @default(cuid())
  employeeId          String
  effectiveFrom       DateTime @db.Date
  salaryBasis         String
  monthlySalary       Decimal @db.Decimal(18, 2)
  monthlyEmployerCost Decimal @db.Decimal(18, 2)
  monthlyHours        Decimal @db.Decimal(8, 2)
  currency            String
  createdAt           DateTime @default(now())
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  timeEntries         EmployeeTimeEntry[]

  @@unique([employeeId, effectiveFrom])
}

model EmployeeDocument {
  id             String   @id @default(cuid())
  employeeId     String
  title          String
  isRequired     Boolean @default(true)
  expiryRequired Boolean @default(true)
  issuedAt       DateTime? @db.Date
  expiresAt      DateTime? @db.Date
  notes          String?
  fileName       String?
  mimeType       String?
  fileData       Bytes?
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
}

model EmployeeTimeEntry {
  id             String   @id @default(cuid())
  employeeId     String
  projectId      String?
  workDate       DateTime @db.Date
  kind           String
  hours          Decimal @db.Decimal(5, 2)
  costMultiplier Decimal @default(1) @db.Decimal(5, 2)
  description    String
  status         String @default("DRAFT")
  compensationId String?
  hourlyCost     Decimal? @db.Decimal(18, 6)
  totalCost      Decimal? @db.Decimal(18, 2)
  currency       String?
  approvedAt     DateTime?
  approvedById   String?
  voidReason     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  compensation   EmployeeCompensation? @relation(fields: [compensationId], references: [id], onDelete: Restrict)

  @@index([employeeId, workDate])
  @@index([projectId, status])
}
