{
  "name": "biem-one",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "dev:api": "pnpm --filter @biem-one/api start:dev",
    "dev:admin": "pnpm --filter @biem-one/admin exec next dev --port 3001",
    "db:generate": "pnpm --filter @biem-one/api exec prisma generate",
    "db:migrate": "pnpm --filter @biem-one/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @biem-one/api exec prisma db seed",
    "db:upgrade:personnel": "pnpm --filter @biem-one/api exec prisma db execute --file prisma/upgrades/20261004_personnel.sql --schema prisma/schema.prisma",
    "start:local": "node scripts/start.mjs",
    "typecheck": "pnpm --filter @biem-one/api exec tsc --noEmit && pnpm --filter @biem-one/admin exec tsc --noEmit",
    "test:acceptance": "node scripts/acceptance.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:personnel:browser": "node scripts/browser-personnel.mjs",
    "test:readiness:browser": "node scripts/browser-readiness.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "turbo": "^2.0.14"
  }
}
