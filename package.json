{
  "name": "biem-one",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "dev:api": "pnpm --filter @biem-one/api start:dev",
    "dev:admin": "pnpm --filter @biem-one/admin exec next dev --port 3001",
    "db:generate": "pnpm --filter @biem-one/api prisma generate",
    "db:migrate": "pnpm --filter @biem-one/api prisma migrate dev",
    "db:seed": "pnpm --filter @biem-one/api prisma db seed",
    "start:local": "node scripts/start.mjs",
    "typecheck": "pnpm --filter @biem-one/api exec tsc --noEmit && pnpm --filter @biem-one/admin exec tsc --noEmit",
    "test:acceptance": "node scripts/acceptance.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.14"
  }
}
