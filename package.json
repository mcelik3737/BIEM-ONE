{
  "name": "biem-one",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "dev:api": "pnpm --filter @biem-one/api start:dev",
    "dev:admin": "pnpm --filter @biem-one/admin dev --port 3001",
    "db:generate": "pnpm --filter @biem-one/api exec prisma generate",
    "db:migrate": "pnpm --filter @biem-one/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @biem-one/api exec prisma db seed",
    "test:acceptance": "pnpm --filter @biem-one/api test:acceptance",
    "db:deploy": "pnpm --filter @biem-one/api exec prisma migrate deploy",
    "test:browser": "node tests/browser-smoke.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
